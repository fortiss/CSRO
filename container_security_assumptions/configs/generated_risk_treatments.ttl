###  https://w3id.org/csro/ontology#ScanContainerImages
csro:ScanContainerImages rdf:type owl:NamedIndividual ,
                             csro:RiskTreatment ;
                    csro:addresses csro:IMG_1 ;
                    csro:description "Perform vulnerability scanning on container images to identify and address security issues" ;
                    rdfs:label "Scan Container Images" .

