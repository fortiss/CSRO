#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( csro:DifficultyLevel
                csro:ExploitabilityRating
                csro:ExposureRating
                csro:Likelihood
                csro:RiskLevel
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( csro:ExploitabilityCalculationRule
                csro:ExposureCalculationRule
                csro:LikelihoodCalculationRule
                csro:RiskCalculationRule
              )
] .


