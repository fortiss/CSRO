###  https://w3id.org/csro/ontology#BalancedContainerSecurityScenario
csro:BalancedContainerSecurityScenario rdf:type owl:NamedIndividual ,
                                                csro:ContextScenario ;
                                       csro:includes csro:Application ,
                                                     csro:Device ,
                                                     csro:DeviceContainerRuntime ,
                                                     csro:DeviceOperatingSystem ,
                                                     csro:OtherApplications ;
                                       csro:includesAssumption csro:BalancedContainerSecurityScenario_AUTH_1 ,
                                                               csro:BalancedContainerSecurityScenario_AUTH_2 ,
                                                               csro:BalancedContainerSecurityScenario_AUTH_3 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_1 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_2 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_3 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_4 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_5 ,
                                                               csro:BalancedContainerSecurityScenario_CIC_6 ,
                                                               csro:BalancedContainerSecurityScenario_CRM_1 ,
                                                               csro:BalancedContainerSecurityScenario_CRM_2 ,
                                                               csro:BalancedContainerSecurityScenario_CRM_3 ,
                                                               csro:BalancedContainerSecurityScenario_CRM_4 ,
                                                               csro:BalancedContainerSecurityScenario_HIS_1 ,
                                                               csro:BalancedContainerSecurityScenario_HIS_2 ,
                                                               csro:BalancedContainerSecurityScenario_HIS_3 ,
