                                                 csro:HybridCloudScenario_IMG_3 ,
                                                 csro:HybridCloudScenario_IMG_4 ,
                                                 csro:HybridCloudScenario_IMG_5 ,
                                                 csro:HybridCloudScenario_IMG_6 ,
                                                 csro:HybridCloudScenario_MON_1 ,
                                                 csro:HybridCloudScenario_MON_2 ,
                                                 csro:HybridCloudScenario_MON_3 ,
                                                 csro:HybridCloudScenario_MON_4 ,
                                                 csro:HybridCloudScenario_MON_5 ,
                                                 csro:HybridCloudScenario_MON_6 ,
                                                 csro:HybridCloudScenario_MON_7 ,
                                                 csro:HybridCloudScenario_MON_8 ,
                                                 csro:HybridCloudScenario_NET_1 ,
