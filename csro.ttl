           csro:originatesFrom csro:OWASP_Docker_Security_Cheat_Sheet_13 ;
           csro:assumptionId "CIC-2" ;
           csro:description "SBOMs are used for the app to track code dependencies" .


###  https://w3id.org/csro/ontology#CIC_3
