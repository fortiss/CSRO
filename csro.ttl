###  https://w3id.org/csro/ontology#RebuildImagesRegularly
csro:RebuildImagesRegularly rdf:type owl:NamedIndividual ,
                                     csro:RiskTreatment ;
                            csro:addresses csro:IMG_5 ;
                            csro:description "Rebuild and update container images regularly to address vulnerabilities and apply patches" ;
                            rdfs:label "Rebuild Images Regularly" .


###  https://w3id.org/csro/ontology#ResourceExhaustionDoS
csro:ResourceExhaustionDoS rdf:type owl:NamedIndividual ,
                                    csro:Impact ;
                           csro:hasImpactRating csro:Critical ;
                           csro:indicates csro:ServiceAvailabilityLossRisk ;
                           csro:description "Complete loss of availability for host system and all hosted applications due to critical resource exhaustion" ;
                           rdfs:label "Resource Exhaustion DoS" .


###  https://w3id.org/csro/ontology#ResourceMisuseRisk
csro:ResourceMisuseRisk rdf:type owl:NamedIndividual ,
                                 csro:Risk ;
                        csro:description "Risk of availability degradation through unauthorized compute resource consumption" ;
                        rdfs:label "Resource Misuse Risk" .


###  https://w3id.org/csro/ontology#RestrictManagementAccess
csro:RestrictManagementAccess rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:AUTH_3 ;
                              csro:description "Restrict access to container management interfaces to authorized users and processes" ;
                              rdfs:label "Restrict Management Access" .


###  https://w3id.org/csro/ontology#RootkitPersistence
csro:RootkitPersistence rdf:type owl:NamedIndividual ,
                                 csro:Impact ;
                        csro:hasImpactRating csro:Disastrous ;
                        csro:indicates csro:StealthyPersistenceRisk ;
                        csro:description "Integrity of kernel compromised through rootkit installation, providing undetectable persistent access bypassing all user-space security controls" ;
                        rdfs:label "Rootkit Persistence" .


###  https://w3id.org/csro/ontology#RunAsNonRootUser
csro:RunAsNonRootUser rdf:type owl:NamedIndividual ,
                               csro:RiskTreatment ;
                      csro:addresses csro:RTS_1 ;
                      csro:hasGuideline csro:GuidelineUserConfiguration ;
                      csro:isImplementedBy csro:non-root_user ;
                      csro:description "Configure containers to run with non-root user privileges to limit potential damage" ;
                      rdfs:label "Run As Non Root User" .


###  https://w3id.org/csro/ontology#RuntimeHardenedScenario
csro:RuntimeHardenedScenario rdf:type owl:NamedIndividual ,
                                      csro:ContextScenario ;
                             csro:includes csro:Application ,
                                           csro:Device ,
                                           csro:DeviceContainerRuntime ,
                                           csro:DeviceOperatingSystem ,
                                           csro:OtherApplications ;
                             csro:includesAssumption csro:RuntimeHardenedScenario_AUTH_1 ,
                                                     csro:RuntimeHardenedScenario_AUTH_2 ,
                                                     csro:RuntimeHardenedScenario_AUTH_3 ,
                                                     csro:RuntimeHardenedScenario_CIC_1 ,
                                                     csro:RuntimeHardenedScenario_CIC_2 ,
                                                     csro:RuntimeHardenedScenario_CIC_3 ,
                                                     csro:RuntimeHardenedScenario_CIC_4 ,
                                                     csro:RuntimeHardenedScenario_CIC_5 ,
                                                     csro:RuntimeHardenedScenario_CIC_6 ,
                                                     csro:RuntimeHardenedScenario_CRM_1 ,
                                                     csro:RuntimeHardenedScenario_CRM_2 ,
                                                     csro:RuntimeHardenedScenario_CRM_3 ,
                                                     csro:RuntimeHardenedScenario_CRM_4 ,
                                                     csro:RuntimeHardenedScenario_HIS_1 ,
                                                     csro:RuntimeHardenedScenario_HIS_2 ,
                                                     csro:RuntimeHardenedScenario_HIS_3 ,
                                                     csro:RuntimeHardenedScenario_IMG_1 ,
                                                     csro:RuntimeHardenedScenario_IMG_2 ,
                                                     csro:RuntimeHardenedScenario_IMG_3 ,
                                                     csro:RuntimeHardenedScenario_IMG_4 ,
                                                     csro:RuntimeHardenedScenario_IMG_5 ,
                                                     csro:RuntimeHardenedScenario_IMG_6 ,
                                                     csro:RuntimeHardenedScenario_MON_1 ,
                                                     csro:RuntimeHardenedScenario_MON_2 ,
                                                     csro:RuntimeHardenedScenario_MON_3 ,
                                                     csro:RuntimeHardenedScenario_MON_4 ,
                                                     csro:RuntimeHardenedScenario_MON_5 ,
                                                     csro:RuntimeHardenedScenario_MON_6 ,
                                                     csro:RuntimeHardenedScenario_MON_7 ,
                                                     csro:RuntimeHardenedScenario_MON_8 ,
                                                     csro:RuntimeHardenedScenario_NET_1 ,
                                                     csro:RuntimeHardenedScenario_NET_2 ,
                                                     csro:RuntimeHardenedScenario_NET_3 ,
                                                     csro:RuntimeHardenedScenario_NET_4 ,
                                                     csro:RuntimeHardenedScenario_RTS_1 ,
                                                     csro:RuntimeHardenedScenario_RTS_2 ,
                                                     csro:RuntimeHardenedScenario_RTS_3 ,
                                                     csro:RuntimeHardenedScenario_RTS_4 ,
                                                     csro:RuntimeHardenedScenario_RTS_5 ,
                                                     csro:RuntimeHardenedScenario_RTS_6 ,
                                                     csro:RuntimeHardenedScenario_RTS_7 ,
                                                     csro:RuntimeHardenedScenario_SCM_1 ,
                                                     csro:RuntimeHardenedScenario_SCM_2 ,
                                                     csro:RuntimeHardenedScenario_SCM_3 ,
                                                     csro:RuntimeHardenedScenario_SCM_4 ;
                             csro:description "Scenario with strong runtime security controls including AppArmor, Seccomp, and read-only filesystems" ;
                             rdfs:label "Runtime Hardened Scenario" .


