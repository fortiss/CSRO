###  https://w3id.org/csro/ontology#IMG_1
csro:IMG_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:isVerifiableBy csro:dockerfile_no_findings ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_4 ,
                               csro:NIST_SP_800_190_Section_4_1_1 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_13 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_9 ;
           csro:assumptionId "IMG-1" ;
           csro:description "App images are scanned for vulnerabilities" .


###  https://w3id.org/csro/ontology#IMG_2
csro:IMG_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_3 ,
                               csro:NIST_SP_800_190_Section_4_1_2 ,
                               csro:OWASP_Docker_Top_10_D04 ;
           csro:assumptionId "IMG-2" ;
           csro:description "App uses minimal base images" .


###  https://w3id.org/csro/ontology#IMG_3
csro:IMG_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_2 ,
                               csro:CIS_Docker_Benchmark_4_5 ,
                               csro:NIST_SP_800_190_Section_4_1_5 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_13 ,
                               csro:OWASP_Docker_Top_10_D08 ;
           csro:assumptionId "IMG-3" ;
           csro:description "App images are signed and verified" .


###  https://w3id.org/csro/ontology#IMG_4
csro:IMG_4 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_6_1 ,
                               csro:NIST_SP_800_190_Section_4_2_2 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_9 ;
           csro:assumptionId "IMG-4" ;
           csro:description "Dockerfiles of the app pin the base image version" .


###  https://w3id.org/csro/ontology#IMG_5
csro:IMG_5 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_4 ,
                               csro:CIS_Docker_Benchmark_5_28 ,
                               csro:NIST_SP_800_190_Section_4_1_1 ,
                               csro:OWASP_Docker_Top_10_D02 ;
           csro:assumptionId "IMG-5" ;
           csro:description "App images are rebuilt and updated regularly" .


###  https://w3id.org/csro/ontology#IMG_6
csro:IMG_6 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ContainerImageSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_2_5 ,
                               csro:CIS_Docker_Benchmark_4_5 ,
                               csro:NIST_SP_800_190_Section_4_2 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_13 ,
                               csro:OWASP_Docker_Top_10_D08 ;
           csro:assumptionId "IMG-6" ;
           csro:description "Device orchestration only uses trusted image registries" .


