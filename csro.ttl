                                                   csro:NISTCompliantScenario_CIC_3 ,
                                                   csro:NISTCompliantScenario_CIC_4 ,
                                                   csro:NISTCompliantScenario_CIC_5 ,
                                                   csro:NISTCompliantScenario_CIC_6 ,
                                                   csro:NISTCompliantScenario_CRM_1 ,
                                                   csro:NISTCompliantScenario_CRM_2 ,
                                                   csro:NISTCompliantScenario_CRM_3 ,
                                                   csro:NISTCompliantScenario_CRM_4 ,
                                                   csro:NISTCompliantScenario_HIS_1 ,
                                                   csro:NISTCompliantScenario_HIS_2 ,
                                                   csro:NISTCompliantScenario_HIS_3 ,
                                                   csro:NISTCompliantScenario_IMG_1 ,
                                                   csro:NISTCompliantScenario_IMG_2 ,
                                                   csro:NISTCompliantScenario_IMG_3 ,
                                                   csro:NISTCompliantScenario_IMG_4 ,
                                                   csro:NISTCompliantScenario_IMG_5 ,
                                                   csro:NISTCompliantScenario_IMG_6 ,
                                                   csro:NISTCompliantScenario_MON_1 ,
                                                   csro:NISTCompliantScenario_MON_2 ,
                                                   csro:NISTCompliantScenario_MON_3 ,
                                                   csro:NISTCompliantScenario_MON_4 ,
                                                   csro:NISTCompliantScenario_MON_5 ,
                                                   csro:NISTCompliantScenario_MON_6 ,
                                                   csro:NISTCompliantScenario_MON_7 ,
                                                   csro:NISTCompliantScenario_MON_8 ,
                                                   csro:NISTCompliantScenario_NET_1 ,
                                                   csro:NISTCompliantScenario_NET_2 ,
                                                   csro:NISTCompliantScenario_NET_3 ,
                                                   csro:NISTCompliantScenario_NET_4 ,
                                                   csro:NISTCompliantScenario_RTS_1 ,
                                                   csro:NISTCompliantScenario_RTS_2 ,
                                                   csro:NISTCompliantScenario_RTS_3 ,
                                                   csro:NISTCompliantScenario_RTS_4 ,
                                                   csro:NISTCompliantScenario_RTS_5 ,
                                                   csro:NISTCompliantScenario_RTS_6 ,
                                                   csro:NISTCompliantScenario_RTS_7 ,
                                                   csro:NISTCompliantScenario_SCM_1 ,
                                                   csro:NISTCompliantScenario_SCM_2 ,
                                                   csro:NISTCompliantScenario_SCM_3 ,
                                                   csro:NISTCompliantScenario_SCM_4 ;
                           csro:description "Scenario following NIST SP 800-190 Application Container Security Guide recommendations" ;
                           rdfs:label "NIST Compliant Scenario" .


