###  https://w3id.org/csro/ontology#RTS_1
csro:RTS_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:RuntimeSecurity ;
           csro:isVerifiableBy csro:non-root_user ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_1 ,
                               csro:CIS_Docker_Benchmark_5_24 ,
                               csro:CIS_Docker_Benchmark_5_31 ,
                               csro:NIST_SP_800_190_Section_4_1_2 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_11 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_2 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_9 ,
                               csro:OWASP_Docker_Top_10_D01 ;
           csro:assumptionId "RTS-1" ;
           csro:description "App containers are run as non-root user" .


###  https://w3id.org/csro/ontology#RTS_2
csro:RTS_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:RuntimeSecurity ;
           csro:isVerifiableBy csro:read_only_filesystem ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_5_13 ,
                               csro:NIST_SP_800_190_Section_4_4_4 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_8 ,
                               csro:OWASP_Docker_Top_10_D09 ;
           csro:assumptionId "RTS-2" ;
           csro:description "App containers use read-only file systems" .


###  https://w3id.org/csro/ontology#RTS_3
csro:RTS_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:RuntimeSecurity ;
           csro:isVerifiableBy csro:cap_drop_all ;
           csro:isVerifiableByAbsence csro:cap_add_CAP_NET_ADMIN ,
                                      csro:cap_add_CAP_SYS_ADMIN ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_8 ,
                               csro:CIS_Docker_Benchmark_5_4 ,
                               csro:NIST_SP_800_190_Section_4_4_3 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_3 ,
                               csro:OWASP_Docker_Top_10_D04 ;
           csro:assumptionId "RTS-3" ;
           csro:description "App containers are deployed with minimal Linux capabilities" .


###  https://w3id.org/csro/ontology#RTS_4
csro:RTS_4 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:RuntimeSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_2_17 ,
                               csro:CIS_Docker_Benchmark_5_22 ,
                               csro:NIST_SP_800_190_Section_4_4_3 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_6 ,
                               csro:OWASP_Docker_Top_10_D04 ;
           csro:assumptionId "RTS-4" ;
           csro:description "Seccomp is implemented on the device" .


###  https://w3id.org/csro/ontology#RTS_5
csro:RTS_5 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:RuntimeSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_5_2 ,
                               csro:NIST_SP_800_190_Section_4_4_3 ,
