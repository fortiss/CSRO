###  https://w3id.org/csro/ontology#MinimizeCapabilities
csro:MinimizeCapabilities rdf:type owl:NamedIndividual ,
                                   csro:RiskTreatment ;
                          csro:addresses csro:RTS_3 ;
                          csro:hasGuideline csro:GuidelineCapabilities ;
                          csro:isImplementedBy csro:cap_drop_all ;
                          csro:description "Deploy containers with minimal Linux capabilities to reduce attack surface" ;
                          rdfs:label "Minimize Capabilities" .


###  https://w3id.org/csro/ontology#MinimizeHostResourceAccess
csro:MinimizeHostResourceAccess rdf:type owl:NamedIndividual ,
                                         csro:RiskTreatment ;
                                csro:addresses csro:RTS_7 ;
                                csro:description "Minimize container access to host resources through proper isolation and restrictions" ;
                                rdfs:label "Minimize Host Resource Access" .


###  https://w3id.org/csro/ontology#Minor
csro:Minor rdf:type owl:NamedIndividual ,
                    csro:RiskLevel ;
           rdfs:label "Minor" .


###  https://w3id.org/csro/ontology#MixedScenario
csro:MixedScenario rdf:type owl:NamedIndividual ,
                            csro:ContextScenario ;
                   csro:includes csro:Application ,
                                 csro:Device ,
                                 csro:DeviceContainerRuntime ,
                                 csro:DeviceOperatingSystem ,
                                 csro:OtherApplications ;
                   csro:includesAssumption csro:MixedScenario_IMG_1 ,
                                           csro:MixedScenario_NET_1 ,
                                           csro:MixedScenario_NET_2 ,
                                           csro:MixedScenario_RTS_1 ,
                                           csro:MixedScenario_RTS_2 ,
                                           csro:MixedScenario_RTS_3 ;
                   csro:description "Mixed container deployment scenario with partial security measures implemented to demonstrate medium ratings." ;
                   rdfs:label "Mixed Scenario" .


