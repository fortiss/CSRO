csro:GuidelineNetworking rdf:type owl:NamedIndividual ,
                                  csro:ContainerSecurityGuideline ;
                         csro:description "Best practices for container network security and segmentation" ;
                         csro:referenceUrl "https://docs.docker.com/network/bridge/" ;
                         rdfs:label "Container Network Security Guidelines" .


