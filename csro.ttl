csro:GuidelineFilesystem rdf:type owl:NamedIndividual ,
                                  csro:ContainerSecurityGuideline ;
                         csro:description "Best practices for container filesystem security" ;
                         csro:referenceUrl "https://docs.docker.com/engine/reference/run/#read-only-containers" ;
                         rdfs:label "Container Filesystem Security Guidelines" .


###  https://w3id.org/csro/ontology#GuidelineNamespaces
csro:GuidelineNamespaces rdf:type owl:NamedIndividual ,
                                  csro:ContainerSecurityGuideline ;
                         csro:description "Best practices for namespace isolation in containers" ;
                         csro:referenceUrl "https://docs.docker.com/engine/security/userns-remap/" ;
                         rdfs:label "Container Namespace Security Guidelines" .


