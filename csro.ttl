###  https://w3id.org/csro/ontology#ContainerPtraceProcessDiscovery
csro:ContainerPtraceProcessDiscovery rdf:type owl:NamedIndividual ,
                                              csro:ContainerAttackTechnique ;
                                     csro:hasBaseDifficulty csro:Medium ;
                                     csro:referencesAttackTechnique d3f:T1057 ;
                                     csro:requiresTrait csro:cap_add_CAP_SYS_PTRACE ,
                                                        csro:host_pid ;
                                     csro:description "Leveraging CAP_SYS_PTRACE and host PID namespace to discover and enumerate host processes for information gathering" ;
                                     rdfs:label "Container Ptrace Process Discovery" .


