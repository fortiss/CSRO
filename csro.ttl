###  https://w3id.org/csro/ontology#CRM_1
csro:CRM_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ComplianceRiskManagement ;
           csro:originatesFrom csro:NIST_SP_800_190_Section_6 ;
           csro:assumptionId "CRM-1" ;
           csro:description "Regular risk assessments of apps and host devices are performed" .


###  https://w3id.org/csro/ontology#CRM_2
csro:CRM_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ComplianceRiskManagement ;
           csro:originatesFrom csro:NIST_SP_800_190_Section_6 ;
           csro:assumptionId "CRM-2" ;
           csro:description "The operation's asset inventory is maintained" .


###  https://w3id.org/csro/ontology#CRM_3
csro:CRM_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:ComplianceRiskManagement ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_2_17 ,
