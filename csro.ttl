#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( csro:DifficultyLevel
                csro:ExploitabilityRating
                csro:ExposureRating
                csro:Likelihood
                csro:RiskLevel
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( csro:ExploitabilityCalculationRule
                csro:ExposureCalculationRule
                csro:LikelihoodCalculationRule
                csro:RiskCalculationRule
              )
] .

###  Impact Instances

csro:ComputeResourceTheft a csro:Impact ;
    csro:description "Availability of compute resources degraded through unauthorized resource consumption, causing performance degradation for legitimate applications and services" ;
    csro:hasImpactRating csro:Moderate ;
    csro:indicates csro:ResourceMisuseRisk .

csro:ContainerEscapeImpact a csro:Impact ;
    csro:description "Complete loss of confidentiality, integrity, and availability of host system through container escape, enabling full unauthorized control over all system resources and data" ;
    csro:hasImpactRating csro:Disastrous ;
    csro:indicates csro:HostCompromiseRisk .

csro:FirewallIntegrityViolation a csro:Impact ;
    csro:description "Integrity of network security controls compromised, exposing all system components and applications to unauthorized network access and potential confidentiality and availability impacts" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:NetworkSecurityControlsRemovalRisk .

csro:HostProcessInformationDisclosure a csro:Impact ;
    csro:description "Confidentiality of host process information compromised, exposing system architecture, running services, and potential security weaknesses" ;
    csro:hasImpactRating csro:Moderate ;
    csro:indicates csro:SystemInformationExposureRisk .

csro:KernelIntegrityCompromise a csro:Impact ;
    csro:description "Complete loss of system integrity and confidentiality at kernel level, enabling persistent unauthorized control over all system operations and data" ;
    csro:hasImpactRating csro:Disastrous ;
    csro:indicates csro:SystemIntegrityLossRisk .

csro:Layer2TrafficInterception a csro:Impact ;
    csro:description "Confidentiality and integrity of network communications compromised through unauthorized traffic interception and potential modification at Layer 2" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:NetworkCommunicationCompromiseRisk .

csro:NetworkSegmentationBypass a csro:Impact ;
    csro:description "Integrity of network isolation controls compromised, enabling unauthorized network access to segmented assets and confidentiality breach across network boundaries" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:NetworkIsolationBreachRisk .

csro:OTSystemCompromise a csro:Impact ;
    csro:description "Integrity and availability of operational technology systems compromised, potentially causing physical process disruption, equipment damage, or safety-critical failures" ;
    csro:hasImpactRating csro:Disastrous ;
    csro:indicates csro:IndustrialSystemCompromiseRisk .

csro:PortHijackingDoS a csro:Impact ;
    csro:description "Availability of network services compromised through port blocking, preventing legitimate applications from accepting connections" ;
    csro:hasImpactRating csro:Moderate ;
    csro:indicates csro:ServiceDisruptionRisk .

csro:ResourceExhaustionDoS a csro:Impact ;
    csro:description "Complete loss of availability for host system and all hosted applications due to critical resource exhaustion" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:ServiceAvailabilityLossRisk .

csro:RootkitPersistence a csro:Impact ;
    csro:description "Integrity of kernel compromised through rootkit installation, providing undetectable persistent access bypassing all user-space security controls" ;
    csro:hasImpactRating csro:Disastrous ;
    csro:indicates csro:StealthyPersistenceRisk .

csro:ServiceImpersonation a csro:Impact ;
    csro:description "Integrity and confidentiality of service authentication compromised through impersonation, enabling unauthorized access and credential theft" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:AuthenticationBypassRisk .

csro:TrafficInterception a csro:Impact ;
    csro:description "Confidentiality of network communications compromised through unauthorized interception, exposing credentials, sensitive data, and application secrets" ;
    csro:hasImpactRating csro:Critical ;
    csro:indicates csro:CredentialTheftRisk .

###  Risk Instances

csro:AuthenticationBypassRisk a csro:Risk ;
    csro:description "Risk of integrity and confidentiality breach through service impersonation enabling authentication bypass" .

csro:CredentialTheftRisk a csro:Risk ;
    csro:description "Risk of confidentiality breach through network traffic interception exposing authentication data" .

csro:HostCompromiseRisk a csro:Risk ;
    csro:description "Risk of total system compromise with complete CIA triad violation through container escape" .

csro:IndustrialSystemCompromiseRisk a csro:Risk ;
    csro:description "Risk of integrity and availability loss in industrial control systems causing physical harm or operational disruption" .

csro:NetworkCommunicationCompromiseRisk a csro:Risk ;
    csro:description "Risk of confidentiality and integrity breach through man-in-the-middle attacks on network communications" .

csro:NetworkIsolationBreachRisk a csro:Risk ;
    csro:description "Risk of integrity violation in network segmentation enabling unauthorized access and confidentiality breach" .

csro:NetworkSecurityControlsRemovalRisk a csro:Risk ;
    csro:description "Risk of integrity violation in network security controls exposing system to comprehensive network-based attacks" .

csro:ResourceMisuseRisk a csro:Risk ;
    csro:description "Risk of availability degradation through unauthorized compute resource consumption" .

csro:ServiceAvailabilityLossRisk a csro:Risk ;
    csro:description "Risk of total availability loss through system resource exhaustion" .

csro:ServiceDisruptionRisk a csro:Risk ;
    csro:description "Risk of availability loss for network services through port resource denial" .

csro:StealthyPersistenceRisk a csro:Risk ;
    csro:description "Risk of undetectable persistent compromise with complete system integrity violation" .

csro:SystemInformationExposureRisk a csro:Risk ;
    csro:description "Risk of confidentiality breach through unauthorized access to host process details enabling targeted attacks" .

csro:SystemIntegrityLossRisk a csro:Risk ;
    csro:description "Risk of total system integrity and confidentiality compromise through persistent kernel-level access" .

