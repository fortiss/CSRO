                     rdfs:comment "The base difficulty level for executing an attack pattern (e.g., Low, Medium, High)."@en ;
                     rdfs:label "Difficulty Level"@en .


###  https://w3id.org/csro/ontology#DockerComposeSetting
csro:DockerComposeSetting rdf:type owl:Class ;
                          rdfs:subClassOf csro:ContainerArtefact ;
                          rdfs:comment "Configuration settings extracted from Docker Compose files as evidence for container deployment traits."@en ;
                          rdfs:label "Docker Compose Setting"@en .


###  https://w3id.org/csro/ontology#ExploitabilityCalculationRule
csro:ExploitabilityCalculationRule rdf:type owl:Class ;
                                   rdfs:subClassOf csro:ContainerAttackTechniqueCalculationRule ;
                                   rdfs:comment "A rule for calculating exploitability ratings based on container attack techniques and security assumptions."@en ;
                                   rdfs:label "Exploitability Calculation Rule"@en .


###  https://w3id.org/csro/ontology#ExploitabilityRating
csro:ExploitabilityRating rdf:type owl:Class ;
                          rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                          rdfs:comment "A rating indicating the ease of exploitation (e.g., Low, Medium, High)."@en ;
                          rdfs:label "Exploitability Rating"@en .


###  https://w3id.org/csro/ontology#ExposureCalculationRule
csro:ExposureCalculationRule rdf:type owl:Class ;
                             rdfs:subClassOf csro:ContainerAttackTechniqueCalculationRule ;
                             rdfs:comment "A rule for calculating exposure ratings based on container attack techniques and security assumptions."@en ;
                             rdfs:label "Exposure Calculation Rule"@en .


###  https://w3id.org/csro/ontology#ExposureRating
csro:ExposureRating rdf:type owl:Class ;
                    rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                    rdfs:comment "A rating indicating the level of exposure to attack (e.g., Low, Medium, High)."@en ;
                    rdfs:label "Exposure Rating"@en .


###  https://w3id.org/csro/ontology#HadolintDockerfileRule
csro:HadolintDockerfileRule rdf:type owl:Class ;
                            rdfs:subClassOf csro:ContainerArtefact ;
                            rdfs:comment "Dockerfile analysis rules and findings from Hadolint tool as evidence for container image security."@en ;
                            rdfs:label "Hadolint Dockerfile Rule"@en .


###  https://w3id.org/csro/ontology#Impact
csro:Impact rdf:type owl:Class ;
            rdfs:subClassOf csro:ContainerSecurityRiskThing ;
            rdfs:comment "The consequence or effect that results from a security threat being realized."@en ;
            rdfs:label "Impact"@en .


###  https://w3id.org/csro/ontology#ImpactRating
csro:ImpactRating rdf:type owl:Class ;
                  rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                  rdfs:comment "A rating indicating the severity of security impact (e.g., Negligible, Moderate, Critical, Disastrous)."@en ;
                  rdfs:label "Impact Rating"@en .


###  https://w3id.org/csro/ontology#Likelihood
csro:Likelihood rdf:type owl:Class ;
                rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                rdfs:comment "A rating indicating the probability of an attack being successful (e.g., Very Unlikely, Unlikely, Possible, Likely, Very Likely)."@en ;
                rdfs:label "Likelihood"@en .


###  https://w3id.org/csro/ontology#LikelihoodCalculationRule
csro:LikelihoodCalculationRule rdf:type owl:Class ;
                               rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                               rdfs:comment "A rule for calculating likelihood ratings from exploitability and exposure ratings."@en ;
                               rdfs:label "Likelihood Calculation Rule"@en .


###  https://w3id.org/csro/ontology#Risk
csro:Risk rdf:type owl:Class ;
          rdfs:subClassOf csro:ContainerSecurityRiskThing ;
          rdfs:comment "A potential security risk resulting from the combination of likelihood and impact."@en ;
          rdfs:label "Risk"@en .


###  https://w3id.org/csro/ontology#RiskCalculationRule
csro:RiskCalculationRule rdf:type owl:Class ;
                         rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                         rdfs:comment "A rule for calculating overall risk levels from likelihood and impact ratings."@en ;
                         rdfs:label "Risk Calculation Rule"@en .


###  https://w3id.org/csro/ontology#RiskLevel
csro:RiskLevel rdf:type owl:Class ;
               rdfs:subClassOf csro:ContainerSecurityRiskThing ;
               rdfs:comment "The overall risk level calculated from likelihood and impact (e.g., Negligible, Minor, Moderate, Significant, Major)."@en ;
               rdfs:label "Risk Level"@en .


###  https://w3id.org/csro/ontology#RiskTreatment
csro:RiskTreatment rdf:type owl:Class ;
                   rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                   rdfs:comment "A strategy or action for mitigating security risks."@en ;
                   rdfs:label "Risk Treatment"@en .


###  https://w3id.org/csro/ontology#SatisfactionState
csro:SatisfactionState rdf:type owl:Class ;
                       rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                       rdfs:comment "The satisfaction state of a security assumption: satisfied, dissatisfied, or unknown."@en ;
                       rdfs:label "Satisfaction State"@en .


###  https://w3id.org/csro/ontology#SecurityAssumption
csro:SecurityAssumption rdf:type owl:Class ;
                        rdfs:subClassOf csro:ContainerSecurityRiskThing ;
                        rdfs:comment "A security assumption about the operational environment of a system for security risk assessment."@en ;
                        rdfs:label "Security Assumption"@en .


