###  https://w3id.org/csro/ontology#CIC_1
csro:CIC_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:CICDSupplyChain ;
           csro:originatesFrom csro:OWASP_Docker_Security_Cheat_Sheet_13 ;
           csro:assumptionId "CIC-1" ;
           csro:description "The CI/CD pipeline for the app is secured (regarding code repositories, build environments, secrets, vulnerabilities, signing, auditing ...)" .


