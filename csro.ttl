                                csro:CIS_Docker_Benchmark_3_4 ,
                                csro:CIS_Docker_Benchmark_5_32 ,
                                csro:NIST_SP_800_190_Section_4_3_1 ,
                                csro:OWASP_Docker_Security_Cheat_Sheet_1 ;
            csro:assumptionId "AUTH-3" ;
            csro:description "Access to container management interfaces (e.g., Docker socket) is restricted" .


###  https://w3id.org/csro/ontology#Application
csro:Application rdf:type owl:NamedIndividual ,
                          csro:Component ;
                 csro:description "Container applications and processes running on the host system." ;
                 rdfs:label "Application" .


###  https://w3id.org/csro/ontology#AuthenticationAccess
csro:AuthenticationAccess rdf:type owl:NamedIndividual ,
                                   csro:AssumptionCategory ;
                          csro:description "Security assumptions related to authentication and access control." .


###  https://w3id.org/csro/ontology#BasicScenario
csro:BasicScenario rdf:type owl:NamedIndividual ,
                            csro:ContextScenario ;
                   csro:includes csro:Application ,
                                 csro:Device ,
                                 csro:DeviceContainerRuntime ,
                                 csro:DeviceOperatingSystem ,
                                 csro:OtherApplications ;
                   csro:includesAssumption csro:BasicScenario_IMG_1 ,
                                           csro:BasicScenario_NET_1 ,
                                           csro:BasicScenario_NET_2 ,
                                           csro:BasicScenario_RTS_1 ,
                                           csro:BasicScenario_RTS_2 ,
                                           csro:BasicScenario_RTS_3 ;
                   csro:description "Basic container deployment scenario with minimal security measures implemented." .


