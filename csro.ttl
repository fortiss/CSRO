###  https://w3id.org/csro/ontology#ContainerFirewallDisable
csro:ContainerFirewallDisable rdf:type owl:NamedIndividual ,
                                       csro:ContainerAttackTechnique ;
                              csro:hasBaseDifficulty csro:Low ;
                              csro:referencesAttackTechnique d3f:T1562.004 ;
                              csro:requiresTrait csro:cap_add_CAP_NET_ADMIN ,
                                                 csro:host_network ;
                              csro:description "Disabling or modifying host firewall rules from containers with CAP_NET_ADMIN capability to remove network security controls" ;
                              rdfs:label "Container Firewall Disable" .


