###  https://w3id.org/csro/ontology#SCM_1
csro:SCM_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:SecretsConfigManagement ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_7_4 ,
                               csro:NIST_SP_800_190_Section_4_1_4 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_12 ,
                               csro:OWASP_Docker_Top_10_D06 ;
           csro:assumptionId "SCM-1" ;
           csro:description "Secure secrets management tools (e.g. vaults or secrets manager) are used" .


###  https://w3id.org/csro/ontology#SCM_2
csro:SCM_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:SecretsConfigManagement ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_4_10 ,
                               csro:NIST_SP_800_190_Section_4_1_4 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_12 ,
                               csro:OWASP_Docker_Top_10_D06 ;
           csro:assumptionId "SCM-2" ;
           csro:description "Apps do not contain any hardcoded secrets" .


###  https://w3id.org/csro/ontology#SCM_3
csro:SCM_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:SecretsConfigManagement ;
           csro:originatesFrom csro:NIST_SP_800_190_Section_4_1_4 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_12 ,
                               csro:OWASP_Docker_Top_10_D06 ;
           csro:assumptionId "SCM-3" ;
           csro:description "Secrets at rest and in transit are encrypted" .


###  https://w3id.org/csro/ontology#SCM_4
csro:SCM_4 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:SecretsConfigManagement ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_7_6 ,
                               csro:CIS_Docker_Benchmark_7_7 ,
                               csro:CIS_Docker_Benchmark_7_8 ,
                               csro:NIST_SP_800_190_Section_4_1_4 ;
           csro:assumptionId "SCM-4" ;
           csro:description "Automatic secret rotation and revocation policies are implemented" .


