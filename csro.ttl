###  https://w3id.org/csro/ontology#HostCompromiseRisk
csro:HostCompromiseRisk rdf:type owl:NamedIndividual ,
                                 csro:Risk ;
                        csro:description "Risk of total system compromise with complete CIA triad violation through container escape" ;
                        rdfs:label "Host Compromise Risk" .


###  https://w3id.org/csro/ontology#HostInfrastructureSecurity
csro:HostInfrastructureSecurity rdf:type owl:NamedIndividual ,
                                         csro:AssumptionCategory ;
                                csro:description "Security assumptions related to host and infrastructure security." ;
                                rdfs:label "Host Infrastructure Security" .


###  https://w3id.org/csro/ontology#HostProcessInformationDisclosure
csro:HostProcessInformationDisclosure rdf:type owl:NamedIndividual ,
                                               csro:Impact ;
                                      csro:hasImpactRating csro:Moderate ;
                                      csro:indicates csro:SystemInformationExposureRisk ;
                                      csro:description "Confidentiality of host process information compromised, exposing system architecture, running services, and potential security weaknesses" ;
                                      rdfs:label "Host Process Information Disclosure" .


###  https://w3id.org/csro/ontology#HostProcessManipulation
csro:HostProcessManipulation rdf:type owl:NamedIndividual ,
                                      csro:Impact ;
                             csro:hasImpactRating csro:Disastrous ;
                             csro:indicates csro:HostProcessManipulationRisk ;
                             csro:description "Integrity and confidentiality of host processes compromised through code injection, enabling unauthorized control and data access at host level" ;
                             rdfs:label "Host Process Manipulation" .


###  https://w3id.org/csro/ontology#HostProcessManipulationRisk
csro:HostProcessManipulationRisk rdf:type owl:NamedIndividual ,
                                          csro:Risk ;
                                 csro:isTreatedBy csro:ConfigureHostFirewall ,
                                                  csro:EnableReadOnlyFilesystem ,
                                                  csro:MinimizeCapabilities ,
                                                  csro:RunAsNonRootUser ,
                                                  csro:ScanContainerImages ,
                                                  csro:SegmentNetworks ;
                                 csro:description "Risk of container escape and host process manipulation through SysPtrace attack" ;
                                 rdfs:label "Host Process Manipulation Risk" .


###  https://w3id.org/csro/ontology#HostSystemFilesExposed
csro:HostSystemFilesExposed rdf:type owl:NamedIndividual ,
                                     csro:Impact ;
                            csro:hasImpactRating csro:Moderate ;
                            csro:indicates csro:HostSystemFilesExposedRisk ;
                            csro:description "Confidential host system files exposed through privileged container volume mounts, potentially revealing sensitive configuration, credentials, or data." ;
                            rdfs:label "Host System Files Exposed" .


###  https://w3id.org/csro/ontology#HostSystemFilesExposedRisk
csro:HostSystemFilesExposedRisk rdf:type owl:NamedIndividual ,
                                         csro:Risk ;
                                csro:isTreatedBy csro:EnableReadOnlyFilesystem ,
                                                 csro:MinimizeCapabilities ,
                                                 csro:RunAsNonRootUser ,
                                                 csro:ScanContainerImages ;
                                csro:description "Risk of sensitive host system files being exposed through container with privileged volume mounts" ;
                                rdfs:label "Host System Files Exposed Risk" .


###  https://w3id.org/csro/ontology#HybridCloudScenario
csro:HybridCloudScenario rdf:type owl:NamedIndividual ,
