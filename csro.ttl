###  https://w3id.org/csro/ontology#NET_1
csro:NET_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:NetworkSecurity ;
           csro:isVerifiableByAbsence csro:external_network ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_5_10 ,
                               csro:CIS_Docker_Benchmark_5_30 ,
                               csro:NIST_SP_800_190_Section_4_3_3 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_5 ,
                               csro:OWASP_Docker_Top_10_D03 ;
           csro:assumptionId "NET-1" ;
           csro:description "App container networks are segmented" .


###  https://w3id.org/csro/ontology#NET_2
csro:NET_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:NetworkSecurity ;
           csro:isVerifiableBy csro:host-level_firewall ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_2_2 ,
                               csro:CIS_Docker_Benchmark_5_14 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_5 ,
                               csro:OWASP_Docker_Top_10_D03 ;
           csro:assumptionId "NET-2" ;
           csro:description "Host-level firewall rules and network policies are applied" .


###  https://w3id.org/csro/ontology#NET_3
csro:NET_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:NetworkSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_7_3 ,
                               csro:NIST_SP_800_190_Section_4_3_3 ;
           csro:assumptionId "NET-3" ;
           csro:description "Inter-container communication is encrypted" .


###  https://w3id.org/csro/ontology#NET_4
csro:NET_4 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:NetworkSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_2_2 ,
                               csro:CIS_Docker_Benchmark_5_14 ,
                               csro:NIST_SP_800_190_Section_4_4_2 ,
                               csro:OWASP_Docker_Top_10_D03 ,
                               csro:OWASP_Docker_Top_10_D04 ;
           csro:assumptionId "NET-4" ;
           csro:description "Ingress/egress controls for containers are implemented" .


###  https://w3id.org/csro/ontology#NISTCompliantScenario
