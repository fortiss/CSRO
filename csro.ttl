###  https://w3id.org/csro/ontology#ContainerPtraceInjection
csro:ContainerPtraceInjection rdf:type owl:NamedIndividual ,
                                       csro:ContainerAttackTechnique ;
                              csro:hasBaseDifficulty csro:Medium ;
                              csro:referencesAttackTechnique d3f:T1055.008 ;
                              csro:requiresTrait csro:cap_add_CAP_SYS_PTRACE ,
                                                 csro:host_pid ;
                              csro:description "Using ptrace system calls for process injection to achieve container escape in environments with CAP_SYS_PTRACE capability and host PID namespace access" ;
