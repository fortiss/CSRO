###  https://w3id.org/csro/ontology#CompromisedContainerProcess
csro:CompromisedContainerProcess rdf:type owl:NamedIndividual ,
                                          csro:Impact ;
                                 csro:hasImpactRating csro:Critical ;
                                 csro:indicates csro:CompromisedContainerProcessRisk ;
                                 csro:description "Integrity and confidentiality of application process compromised through exploitation of public-facing vulnerabilities, enabling unauthorized control of the compromised application" .


###  https://w3id.org/csro/ontology#CompromisedContainerProcessRisk
csro:CompromisedContainerProcessRisk rdf:type owl:NamedIndividual ,
                                              csro:Risk ;
                                     csro:isTreatedBy csro:ConfigureHostFirewall ,
                                                      csro:RunAsNonRootUser ,
                                                      csro:ScanContainerImages ,
                                                      csro:SegmentNetworks ;
                                     csro:description "Risk of container process compromise through exploitation of vulnerabilities in public-facing applications" ;
                                     rdfs:label "Compromised Container Process Risk" .


###  https://w3id.org/csro/ontology#ConfigureHostFirewall
csro:ConfigureHostFirewall rdf:type owl:NamedIndividual ,
                                    csro:RiskTreatment ;
                           csro:addresses csro:NET_2 ;
                           csro:hasGuideline csro:GuidelineNetworking ;
                           csro:isImplementedBy csro:host-level_firewall ;
                           csro:description "Configure host-level firewall rules and network policies to control traffic" ;
                           rdfs:label "Configure Host-Level Firewall" .


###  https://w3id.org/csro/ontology#ContainerDataFromLocalSystem
csro:ContainerDataFromLocalSystem rdf:type owl:NamedIndividual ,
                                           csro:ContainerAttackTechnique ;
                                  csro:hasBaseDifficulty csro:Low ;
                                  csro:referencesAttackTechnique d3f:T1005 ;
                                  csro:requiresTrait csro:cap_add_CAP_DAC_READ_SEARCH ,
                                                     csro:privileged_host_volume ;
                                  csro:description "Container-specific adaptation of MITRE ATT&CK T1005 (Data from Local System) where containers with privileged host volume mounts can access sensitive host system files and directories, potentially exposing confidential information." .


###  https://w3id.org/csro/ontology#ContainerDataFromLocalSystemAttack_BasicScenario
csro:ContainerDataFromLocalSystemAttack_BasicScenario rdf:type owl:NamedIndividual ,
                                                               csro:AttackAction ;
                                                      csro:affects csro:Application ,
                                                                   csro:Device ,
                                                                   csro:DeviceContainerRuntime ,
                                                                   csro:DeviceOperatingSystem ;
                                                      csro:appliesTechnique csro:ContainerDataFromLocalSystem ;
                                                      csro:causesImpact csro:HostSystemFilesExposed ;
                                                      csro:inContext csro:BasicScenario ;
                                                      csro:description "Container data from local system attack (T1005) applied in basic scenario" .


###  https://w3id.org/csro/ontology#ContainerDataFromLocalSystemAttack_HardenedScenario
csro:ContainerDataFromLocalSystemAttack_HardenedScenario rdf:type owl:NamedIndividual ,
                                                                  csro:AttackAction ;
                                                         csro:affects csro:Application ,
                                                                      csro:Device ,
                                                                      csro:DeviceContainerRuntime ,
                                                                      csro:DeviceOperatingSystem ;
                                                         csro:appliesTechnique csro:ContainerDataFromLocalSystem ;
                                                         csro:causesImpact csro:HostSystemFilesExposed ;
                                                         csro:inContext csro:HardenedScenario ;
                                                         csro:description "Container data from local system attack (T1005) applied in hardened scenario" .


###  https://w3id.org/csro/ontology#ContainerDataFromLocalSystemAttack_MixedScenario
csro:ContainerDataFromLocalSystemAttack_MixedScenario rdf:type owl:NamedIndividual ,
                                                               csro:AttackAction ;
                                                      csro:affects csro:Application ,
                                                                   csro:Device ,
                                                                   csro:DeviceContainerRuntime ,
                                                                   csro:DeviceOperatingSystem ;
