                               csro:NIST_SP_800_190_Section_6 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_5 ;
           csro:assumptionId "CRM-3" ;
           csro:description "Container security policies along the app lifecycle are documented and enforced" .


