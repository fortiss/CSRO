###  https://w3id.org/csro/ontology#EnableContainerLogging
csro:EnableContainerLogging rdf:type owl:NamedIndividual ,
                                     csro:RiskTreatment ;
                            csro:addresses csro:MON_1 ;
                            csro:description "Enable comprehensive container-level logging for security monitoring and audit" ;
                            rdfs:label "Enable Container Logging" .


###  https://w3id.org/csro/ontology#EnableReadOnlyFilesystem
csro:EnableReadOnlyFilesystem rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:RTS_2 ;
                              csro:hasGuideline csro:GuidelineFilesystem ;
                              csro:isImplementedBy csro:read_only_filesystem ;
                              csro:description "Mount container filesystem as read-only to prevent malicious file modifications" ;
                              rdfs:label "Enable Read Only Filesystem" .


###  https://w3id.org/csro/ontology#EnableReproducibleBuilds
csro:EnableReproducibleBuilds rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:CIC_5 ;
                              csro:description "Enable reproducible builds in CI/CD pipeline to ensure build consistency" ;
                              rdfs:label "Enable Reproducible Builds" .


###  https://w3id.org/csro/ontology#EncryptInterContainerCommunication
csro:EncryptInterContainerCommunication rdf:type owl:NamedIndividual ,
                                                 csro:RiskTreatment ;
                                        csro:addresses csro:NET_3 ;
                                        csro:description "Encrypt inter-container communication to protect data in transit" ;
                                        rdfs:label "Encrypt Inter Container Communication" .


