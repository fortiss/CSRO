###  https://w3id.org/csro/ontology#AUTH_1
csro:AUTH_1 rdf:type owl:NamedIndividual ,
                     csro:ContainerSecurityAssumption ;
            csro:belongsToCategory csro:AuthenticationAccess ;
            csro:originatesFrom csro:CIS_Docker_Benchmark_2_7 ,
                                csro:NIST_SP_800_190_Section_4_3_2 ,
                                csro:OWASP_Docker_Top_10_D04 ;
            csro:assumptionId "AUTH-1" ;
            csro:description "Authentication for exposed container APIs is enforced" .


###  https://w3id.org/csro/ontology#AUTH_2
csro:AUTH_2 rdf:type owl:NamedIndividual ,
                     csro:ContainerSecurityAssumption ;
            csro:belongsToCategory csro:AuthenticationAccess ;
            csro:originatesFrom csro:CIS_Docker_Benchmark_2_12 ,
                                csro:NIST_SP_800_190_Section_4_3_1 ;
            csro:assumptionId "AUTH-2" ;
            csro:description "Role-based access control is used for orchestration and container management" .


###  https://w3id.org/csro/ontology#AUTH_3
csro:AUTH_3 rdf:type owl:NamedIndividual ,
                     csro:ContainerSecurityAssumption ;
            csro:belongsToCategory csro:AuthenticationAccess ;
            csro:originatesFrom csro:CIS_Docker_Benchmark_3_23 ,
                                csro:CIS_Docker_Benchmark_3_24 ,
                                csro:CIS_Docker_Benchmark_3_3 ,
                                csro:CIS_Docker_Benchmark_3_4 ,
                                csro:CIS_Docker_Benchmark_5_32 ,
                                csro:NIST_SP_800_190_Section_4_3_1 ,
                                csro:OWASP_Docker_Security_Cheat_Sheet_1 ;
            csro:assumptionId "AUTH-3" ;
            csro:description "Access to container management interfaces (e.g., Docker socket) is restricted" .


