csro:EnforceAPIAuthentication rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:AUTH_1 ;
                              csro:description "Enforce authentication mechanisms for all exposed container APIs" ;
                              rdfs:label "Enforce API Authentication" .


###  https://w3id.org/csro/ontology#EnforceCodeReviewsAndTesting
csro:EnforceCodeReviewsAndTesting rdf:type owl:NamedIndividual ,
                                           csro:RiskTreatment ;
                                  csro:addresses csro:CIC_3 ;
                                  csro:description "Enforce code reviews and automated testing to identify security issues early" ;
                                  rdfs:label "Enforce Code Reviews And Testing" .


###  https://w3id.org/csro/ontology#FirewallIntegrityViolation
csro:FirewallIntegrityViolation rdf:type owl:NamedIndividual ,
                                         csro:Impact ;
                                csro:hasImpactRating csro:Critical ;
                                csro:indicates csro:NetworkSecurityControlsRemovalRisk ;
                                csro:description "Integrity of network security controls compromised, exposing all system components and applications to unauthorized network access and potential confidentiality and availability impacts" ;
                                rdfs:label "Firewall Integrity Violation" .


