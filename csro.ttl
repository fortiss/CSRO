###  https://w3id.org/csro/ontology#Device
csro:Device rdf:type owl:NamedIndividual ,
                     csro:Component ;
            csro:description "Physical or virtual device hosting the container runtime." ;
            rdfs:label "Device" .


###  https://w3id.org/csro/ontology#DeviceAccess
csro:DeviceAccess rdf:type owl:NamedIndividual ,
                           csro:ContainerDeploymentTrait ;
                  csro:description "Container has access to host devices" ;
                  rdfs:label "device_access" .


###  https://w3id.org/csro/ontology#DeviceContainerRuntime
csro:DeviceContainerRuntime rdf:type owl:NamedIndividual ,
                                     csro:Component ;
                            csro:description "Container runtime engine (e.g., Docker, containerd) running on the host device." ;
                            rdfs:label "Device Container Runtime" .


###  https://w3id.org/csro/ontology#DeviceOperatingSystem
csro:DeviceOperatingSystem rdf:type owl:NamedIndividual ,
                                    csro:Component ;
                           csro:description "Host operating system where containers are deployed." ;
                           rdfs:label "Device Operating System" .


###  https://w3id.org/csro/ontology#Disastrous
csro:Disastrous rdf:type owl:NamedIndividual ,
                         csro:ImpactRating ;
                csro:description "Disastrous impact rating indicating catastrophic consequences." .


###  https://w3id.org/csro/ontology#Dissatisfied
csro:Dissatisfied rdf:type owl:NamedIndividual ,
                           csro:SatisfactionState ;
                  csro:description "The security assumption is not satisfied/implemented." .


###  https://w3id.org/csro/ontology#DocumentSecurityPolicies
csro:DocumentSecurityPolicies rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:CRM_3 ;
                              csro:description "Document and enforce container security policies throughout application lifecycle" ;
                              rdfs:label "Document Security Policies" .


###  https://w3id.org/csro/ontology#EdgeComputingScenario
csro:EdgeComputingScenario rdf:type owl:NamedIndividual ,
                                    csro:ContextScenario ;
                           csro:includes csro:Application ,
                                         csro:Device ,
                                         csro:DeviceContainerRuntime ,
                                         csro:DeviceOperatingSystem ,
                                         csro:OtherApplications ;
                           csro:includesAssumption csro:EdgeComputingScenario_AUTH_1 ,
                                                   csro:EdgeComputingScenario_AUTH_2 ,
                                                   csro:EdgeComputingScenario_AUTH_3 ,
                                                   csro:EdgeComputingScenario_CIC_1 ,
                                                   csro:EdgeComputingScenario_CIC_2 ,
                                                   csro:EdgeComputingScenario_CIC_3 ,
                                                   csro:EdgeComputingScenario_CIC_4 ,
                                                   csro:EdgeComputingScenario_CIC_5 ,
                                                   csro:EdgeComputingScenario_CIC_6 ,
                                                   csro:EdgeComputingScenario_CRM_1 ,
                                                   csro:EdgeComputingScenario_CRM_2 ,
                                                   csro:EdgeComputingScenario_CRM_3 ,
                                                   csro:EdgeComputingScenario_CRM_4 ,
                                                   csro:EdgeComputingScenario_HIS_1 ,
                                                   csro:EdgeComputingScenario_HIS_2 ,
                                                   csro:EdgeComputingScenario_HIS_3 ,
                                                   csro:EdgeComputingScenario_IMG_1 ,
                                                   csro:EdgeComputingScenario_IMG_2 ,
                                                   csro:EdgeComputingScenario_IMG_3 ,
                                                   csro:EdgeComputingScenario_IMG_4 ,
                                                   csro:EdgeComputingScenario_IMG_5 ,
                                                   csro:EdgeComputingScenario_IMG_6 ,
                                                   csro:EdgeComputingScenario_MON_1 ,
                                                   csro:EdgeComputingScenario_MON_2 ,
                                                   csro:EdgeComputingScenario_MON_3 ,
                                                   csro:EdgeComputingScenario_MON_4 ,
                                                   csro:EdgeComputingScenario_MON_5 ,
                                                   csro:EdgeComputingScenario_MON_6 ,
                                                   csro:EdgeComputingScenario_MON_7 ,
                                                   csro:EdgeComputingScenario_MON_8 ,
                                                   csro:EdgeComputingScenario_NET_1 ,
                                                   csro:EdgeComputingScenario_NET_2 ,
                                                   csro:EdgeComputingScenario_NET_3 ,
                                                   csro:EdgeComputingScenario_NET_4 ,
                                                   csro:EdgeComputingScenario_RTS_1 ,
                                                   csro:EdgeComputingScenario_RTS_2 ,
                                                   csro:EdgeComputingScenario_RTS_3 ,
                                                   csro:EdgeComputingScenario_RTS_4 ,
                                                   csro:EdgeComputingScenario_RTS_5 ,
                                                   csro:EdgeComputingScenario_RTS_6 ,
                                                   csro:EdgeComputingScenario_RTS_7 ,
                                                   csro:EdgeComputingScenario_SCM_1 ,
                                                   csro:EdgeComputingScenario_SCM_2 ,
                                                   csro:EdgeComputingScenario_SCM_3 ,
                                                   csro:EdgeComputingScenario_SCM_4 ;
                           csro:description "Edge computing deployment with limited central monitoring and physical security constraints" ;
                           rdfs:label "Edge Computing Scenario" .


