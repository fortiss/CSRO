                                         csro:ContainerSecurityGuideline ;
                                csro:description "Best practices for configuring container user permissions" ;
                                csro:referenceUrl "https://docs.docker.com/develop/dev-best-practices/#how-to-keep-your-images-small" ;
                                rdfs:label "Container User Configuration Guidelines" .


###  https://w3id.org/csro/ontology#HIS_1
csro:HIS_1 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:HostInfrastructureSecurity ;
           csro:originatesFrom csro:CIS_Docker_Benchmark_1_2_2 ,
                               csro:NIST_SP_800_190_Section_4_5_3 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_0 ,
                               csro:OWASP_Docker_Top_10_D02 ;
           csro:assumptionId "HIS-1" ;
           csro:description "The container runtime on the host device is up to date" .


###  https://w3id.org/csro/ontology#HIS_2
csro:HIS_2 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:HostInfrastructureSecurity ;
           csro:originatesFrom csro:NIST_SP_800_190_Section_4_5_3 ,
                               csro:OWASP_Docker_Security_Cheat_Sheet_8 ,
                               csro:OWASP_Docker_Top_10_D09 ;
           csro:assumptionId "HIS-2" ;
           csro:description "The host device is deployed as an immutable infrastructure (e.g. read-only file system)" .


###  https://w3id.org/csro/ontology#HIS_3
csro:HIS_3 rdf:type owl:NamedIndividual ,
                    csro:ContainerSecurityAssumption ;
           csro:belongsToCategory csro:HostInfrastructureSecurity ;
           csro:originatesFrom csro:NIST_SP_800_190_Section_4_5_5 ;
           csro:assumptionId "HIS-3" ;
           csro:description "The host device is monitored for unauthorized changes" .


