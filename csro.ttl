###  https://w3id.org/csro/ontology#CentralizeAndProtectLogs
csro:CentralizeAndProtectLogs rdf:type owl:NamedIndividual ,
                                       csro:RiskTreatment ;
                              csro:addresses csro:MON_5 ;
                              csro:description "Centralize logs and implement protection mechanisms to ensure integrity" ;
                              rdfs:label "Centralize And Protect Logs" .


###  https://w3id.org/csro/ontology#ComplianceRiskManagement
csro:ComplianceRiskManagement rdf:type owl:NamedIndividual ,
                                       csro:AssumptionCategory ;
                              csro:description "Security assumptions related to compliance and risk management." ;
                              rdfs:label "Compliance & Risk Management" .


###  https://w3id.org/csro/ontology#CompromisedContainerProcess
csro:CompromisedContainerProcess rdf:type owl:NamedIndividual ,
                                          csro:Impact ;
                                 csro:hasImpactRating csro:Critical ;
                                 csro:indicates csro:CompromisedContainerProcessRisk ;
                                 csro:description "Integrity and confidentiality of application process compromised through exploitation of public-facing vulnerabilities, enabling unauthorized control of the compromised application" ;
                                 rdfs:label "Compromised Container Process" .


###  https://w3id.org/csro/ontology#CompromisedContainerProcessRisk
csro:CompromisedContainerProcessRisk rdf:type owl:NamedIndividual ,
                                              csro:Risk ;
                                     csro:isTreatedBy csro:ConfigureHostFirewall ,
                                                      csro:RunAsNonRootUser ,
                                                      csro:ScanContainerImages ,
                                                      csro:SegmentNetworks ;
                                     csro:description "Risk of container process compromise through exploitation of vulnerabilities in public-facing applications" ;
                                     rdfs:label "Compromised Container Process Risk" .


###  https://w3id.org/csro/ontology#ComputeResourceTheft
csro:ComputeResourceTheft rdf:type owl:NamedIndividual ,
                                   csro:Impact ;
                          csro:hasImpactRating csro:Moderate ;
                          csro:indicates csro:ResourceMisuseRisk ;
                          csro:description "Availability of compute resources degraded through unauthorized resource consumption, causing performance degradation for legitimate applications and services" ;
                          rdfs:label "Compute Resource Theft" .


###  https://w3id.org/csro/ontology#ConductPeriodicAudits
csro:ConductPeriodicAudits rdf:type owl:NamedIndividual ,
                                    csro:RiskTreatment ;
                           csro:addresses csro:CRM_4 ;
                           csro:description "Conduct periodic security audits and reviews of containers and host devices" ;
                           rdfs:label "Conduct Periodic Audits" .


###  https://w3id.org/csro/ontology#ConfigureHostFirewall
csro:ConfigureHostFirewall rdf:type owl:NamedIndividual ,
                                    csro:RiskTreatment ;
                           csro:addresses csro:NET_2 ;
                           csro:hasGuideline csro:GuidelineNetworking ;
                           csro:isImplementedBy csro:host-level_firewall ;
                           csro:description "Configure host-level firewall rules and network policies to control traffic" ;
                           rdfs:label "Configure Host Firewall" .


###  https://w3id.org/csro/ontology#ContainerCgroupDoS
csro:ContainerCgroupDoS rdf:type owl:NamedIndividual ,
                                 csro:ContainerAttackTechnique ;
                        csro:hasBaseDifficulty csro:Low ;
                        csro:referencesAttackTechnique d3f:T1499 ;
                        csro:requiresTrait csro:host_cgroup ;
                        csro:description "Manipulating cgroup limits to cause denial of service by exhausting host system resources" ;
                        rdfs:label "Container Cgroup DoS" .


###  https://w3id.org/csro/ontology#ContainerCgroupDoSAttack_AirGappedScenario
csro:ContainerCgroupDoSAttack_AirGappedScenario rdf:type owl:NamedIndividual ,
                                                         csro:AttackAction ;
                                                csro:affects csro:Device ,
                                                             csro:DeviceContainerRuntime ,
                                                             csro:OtherApplications ;
                                                csro:appliesTechnique csro:ContainerCgroupDoS ;
                                                csro:causesImpact csro:ResourceExhaustionDoS ;
                                                csro:inContext csro:AirGappedScenario ;
                                                csro:description "ContainerCgroupDoS attack applied in AirGappedScenario context" .


###  https://w3id.org/csro/ontology#ContainerCgroupDoSAttack_BalancedContainerSecurityScenario
csro:ContainerCgroupDoSAttack_BalancedContainerSecurityScenario rdf:type owl:NamedIndividual ,
