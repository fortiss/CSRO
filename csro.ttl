csro:GuidelineCapabilities rdf:type owl:NamedIndividual ,
                                    csro:ContainerSecurityGuideline ;
                           csro:description "Best practices for managing Linux capabilities in containers" ;
                           csro:referenceUrl "https://docs.docker.com/engine/reference/run/#runtime-privilege-and-linux-capabilities" ;
                           rdfs:label "Container Capabilities Security Guidelines" .


