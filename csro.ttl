                                                 csro:HybridCloudScenario_SCM_1 ,
                                                 csro:HybridCloudScenario_SCM_2 ,
                                                 csro:HybridCloudScenario_SCM_3 ,
                                                 csro:HybridCloudScenario_SCM_4 ;
                         csro:description "Hybrid cloud deployment with varying security controls across on-premises and cloud environments" ;
                         rdfs:label "Hybrid Cloud Scenario" .


