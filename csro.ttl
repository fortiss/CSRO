csro:EncryptSecrets rdf:type owl:NamedIndividual ,
                             csro:RiskTreatment ;
                    csro:addresses csro:SCM_3 ;
                    csro:description "Encrypt secrets both at rest and in transit to protect sensitive data" ;
                    rdfs:label "Encrypt Secrets" .


